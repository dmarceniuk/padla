<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🏓 Ping Pong Rotation — Постійні Пари та Свінгер</title>

<style>
    :root {
        --bg: #0b0f19;
        --card: #131d2f;
        --card-hover: #19253d;
        --card-subtle: #1a273f;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --accent: #f59e0b;
        --green: #10b981;
        --green-bg: rgba(16, 185, 129, 0.15);
        --red: #ef4444;
        --red-bg: rgba(239, 68, 68, 0.15);
        --orange: #f97316;
        --purple: #a855f7;
        --border: #223049;
        --radius: 14px;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
    }

    html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.4;
    }

    /* HEADER */
    header {
        background: rgba(11, 15, 25, 0.94);
        border-bottom: 1px solid var(--border);
        padding: 12px 16px;
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
    }

    .header-inner {
        max-width: 900px;
        margin: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .logo-box {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    h1 {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.3px;
        background: linear-gradient(135deg, #60a5fa, #c084fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .day-selector select {
        background: #1a273f;
        color: var(--text);
        border: 1px solid var(--border);
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        outline: none;
    }

    /* MAIN */
    main {
        max-width: 900px;
        margin: auto;
        padding: 14px 12px 60px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* CARDS */
    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    h2 {
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .badge-swinger {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(236, 72, 153, 0.2));
        color: #e879f9;
        border: 1px solid rgba(168, 85, 247, 0.4);
    }

    /* BUTTONS */
    button {
        border: 0;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .1s, filter .1s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        user-select: none;
    }

    button:active {
        transform: scale(0.96) !important;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: var(--card-subtle);
        color: var(--text);
        border: 1px solid var(--border);
    }

    .btn-danger {
        background: var(--red-bg);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-undo {
        background: #334155;
        color: #f1f5f9;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 8px;
    }

    .btn-sm {
        padding: 6px 10px;
        font-size: 12px;
        border-radius: 8px;
    }

    input, select {
        border: 1px solid var(--border);
        background: #0b0f19;
        color: var(--text);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 14px;
        outline: none;
    }

    input:focus, select:focus {
        border-color: var(--primary);
    }

    /* CURRENT MATCH */
    .current-match-card {
        background: linear-gradient(180deg, #18243c 0%, #111a2c 100%);
        border: 2px solid #3b82f6;
        position: relative;
    }

    .match-header-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .match-tag {
        font-size: 12px;
        font-weight: 800;
        color: #93c5fd;
        background: rgba(59, 130, 246, 0.2);
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid rgba(59, 130, 246, 0.4);
    }

    .teams-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 10px;
        margin: 12px 0;
    }

    .team-box {
        border-radius: 12px;
        padding: 14px 10px;
        text-align: center;
        border: 2px solid;
    }

    .team-a {
        border-color: #3b82f6;
        background: rgba(59, 130, 246, 0.12);
    }

    .team-b {
        border-color: #f97316;
        background: rgba(249, 115, 22, 0.12);
    }

    .team-box.final-game {
        border-color: #f59e0b;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
    }

    .team-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .team-a .team-title { color: #60a5fa; }
    .team-b .team-title { color: #fb923c; }

    .team-names {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        word-break: break-word;
    }

    .game-pill {
        display: inline-block;
        margin-top: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 10px;
    }

    .game-pill.game-1 {
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .game-pill.game-2 {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.4);
    }

    .vs-divider {
        font-weight: 900;
        font-size: 13px;
        color: var(--text-muted);
        background: #0b0f19;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        margin: auto;
    }

    .action-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 14px;
    }

    .btn-win-a {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        padding: 14px;
        font-size: 14px;
        font-weight: 700;
        min-height: 48px;
    }

    .btn-win-b {
        background: linear-gradient(135deg, #ea580c, #c2410c);
        color: white;
        padding: 14px;
        font-size: 14px;
        font-weight: 700;
        min-height: 48px;
    }

    .rotation-status-banner {
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #0b0f19;
        border: 1px solid var(--border);
        font-size: 12px;
        color: var(--text-muted);
    }

    .rotation-status-banner strong {
        color: #e2e8f0;
    }

    /* PAIRS BUILDER */
    .pairs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .pair-card {
        background: #0b0f19;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .pair-card.swinger-card {
        border-color: rgba(168, 85, 247, 0.4);
        background: linear-gradient(180deg, rgba(168, 85, 247, 0.08) 0%, #0b0f19 100%);
    }

    .pair-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pair-card-title {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: #93c5fd;
    }

    .pair-players-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .player-row-item {
        background: #151d2f;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        font-weight: 600;
    }

    .player-row-item.empty-slot {
        background: rgba(255, 255, 255, 0.02);
        border-style: dashed;
        color: var(--text-muted);
        font-size: 12px;
        justify-content: center;
        padding: 10px;
    }

    .player-row-item.paused {
        opacity: 0.5;
        border-style: dashed;
    }

    .player-actions-mini {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .pair-select-mini {
        padding: 4px 6px;
        font-size: 11px;
        border-radius: 6px;
        background: #0f172a;
        color: #93c5fd;
        font-weight: 700;
        border: 1px solid #334155;
    }

    .mini-btn {
        background: #1c2a44;
        border: 1px solid #334155;
        color: var(--text-muted);
        padding: 4px 7px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
    }

    .mini-btn:hover {
        color: white;
        background: #3b82f6;
    }

    .mini-btn.remove:hover {
        background: #ef4444;
    }

    /* QUEUE / BENCH PREVIEW */
    .queue-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 10px;
    }

    .queue-box {
        background: #0b0f19;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
    }

    .queue-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
    }

    .queue-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        background: #151d2f;
        border-radius: 8px;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .queue-item:last-child {
        margin-bottom: 0;
    }

    .swinger-badge {
        background: linear-gradient(135deg, #8b5cf6, #ec4899);
        color: white;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 10px;
    }

    /* SUMMARY CARDS */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .summary-card {
        background: #0b0f19;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 8px;
        text-align: center;
    }

    .summary-val {
        font-size: 20px;
        font-weight: 800;
        color: #f8fafc;
    }

    .summary-lbl {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* TABLES */
    .table-responsive {
        overflow-x: auto;
        margin-top: 8px;
        border-radius: 8px;
        border: 1px solid var(--border);
        -webkit-overflow-scrolling: touch;
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 13px;
        white-space: nowrap;
    }

    .stats-table th {
        background: #0b0f19;
        padding: 10px 12px;
        color: var(--text-muted);
        font-weight: 700;
        border-bottom: 1px solid var(--border);
        font-size: 11px;
        text-transform: uppercase;
    }

    .stats-table td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
    }

    .rank-cell {
        font-weight: 800;
        width: 28px;
    }

    .rank-1 { color: #f59e0b; }
    .rank-2 { color: #94a3b8; }
    .rank-3 { color: #b45309; }

    .streak-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 6px;
    }

    .streak-w {
        background: var(--green-bg);
        color: #34d399;
    }

    .streak-l {
        background: var(--red-bg);
        color: #f87171;
    }

    /* HISTORY */
    .day-tabs {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        margin-bottom: 10px;
        padding-bottom: 2px;
    }

    .day-tab {
        background: #0b0f19;
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
    }

    .day-tab.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    .history-item {
        background: #0b0f19;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
    }

    .history-main {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .history-num {
        font-weight: 800;
        color: var(--text-muted);
    }

    .history-winner { color: #60a5fa; font-weight: 700; }
    .history-loser { color: var(--text-muted); }

    .history-meta {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-delete-match {
        background: none;
        color: #64748b;
        padding: 4px;
        font-size: 13px;
    }

    .empty-state {
        text-align: center;
        padding: 25px 10px;
        color: var(--text-muted);
        font-size: 13px;
    }

    .controls-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    /* TOAST */
    #toastContainer {
        position: fixed;
        bottom: 16px;
        left: 16px;
        right: 16px;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 8px;
        pointer-events: none;
    }

    .toast {
        background: #1e293b;
        border: 1px solid #475569;
        color: #f8fafc;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.5);
    }

    .toast.success { border-color: #10b981; background: #064e3b; }
    .toast.error { border-color: #ef4444; background: #7f1d1d; }
    .toast.info { border-color: #3b82f6; background: #1e3a8a; }

    /* MOBILE BREAKPOINT */
    @media (max-width: 600px) {
        main {
            padding: 10px 8px 50px;
            gap: 10px;
        }

        .card {
            padding: 14px 10px;
        }

        .teams-grid {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .action-buttons {
            grid-template-columns: 1fr;
        }

        .btn-win-a, .btn-win-b {
            min-height: 52px;
            font-size: 15px;
        }

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .queue-container {
            grid-template-columns: 1fr;
        }

        .pairs-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
</head>

<body>

<header>
    <div class="header-inner">
        <div class="logo-box">
            <span>🏓</span>
            <h1>Ping Pong Rotation</h1>
        </div>

        <div class="day-selector">
            <select id="daySelect" onchange="changeDay()">
                <option value="mon">Понеділок</option>
                <option value="tue">Вівторок</option>
                <option value="wed">Середа</option>
                <option value="thu">Четвер</option>
                <option value="fri">П'ятниця</option>
                <option value="sat">Субота</option>
                <option value="sun">Неділя</option>
            </select>
        </div>
    </div>
</header>

<main>

    <!-- CURRENT MATCH -->
    <section id="matchCard" class="card current-match-card">
        <div class="card-header">
            <h2>🏓 Зараз грають</h2>
            <div id="matchHeaderRight"></div>
        </div>

        <div id="matchContent"></div>
    </section>

    <!-- BENCH / QUEUE PREVIEW -->
    <section class="card">
        <div class="card-header">
            <h2>⏳ Черга виходу на стіл</h2>
            <button class="btn-secondary btn-sm" onclick="rebuildRotation()">🔄 Скинути чергу</button>
        </div>

        <div class="queue-container">
            <div class="queue-box">
                <div class="queue-title">
                    <span>👥 Пари в черзі</span>
                    <span id="queueCount" class="badge">0</span>
                </div>
                <div id="queueList"></div>
            </div>

            <div class="queue-box">
                <div class="queue-title">
                    <span>🔄 Свінгер (підміна)</span>
                    <span id="swingerStatusBadge" class="badge">Немає</span>
                </div>
                <div id="swingerList"></div>
            </div>
        </div>
    </section>

    <!-- PLAYERS & CUSTOM PAIRS BUILDER -->
    <section class="card">
        <div class="card-header">
            <h2>👥 Склад пар та гравці (<span id="playerCount">0</span>)</h2>
            <button class="btn-secondary btn-sm" onclick="autoBalancePairs()">🎲 Авто-розподіл пар</button>
        </div>

        <!-- INPUT FORM WITH PAIR SELECTOR -->
        <div style="background: #0b0f19; border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-bottom: 12px;">
            <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase;">
                ➕ Додати нового гравця:
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <input
                    id="playerInput"
                    type="text"
                    placeholder="Ім'я гравця..."
                    style="flex: 2; min-width: 150px;"
                    onkeydown="if(event.key === 'Enter') addPlayer()"
                >
                <select id="pairSelectDropdown" style="flex: 1; min-width: 140px;">
                    <option value="auto">✨ Авто-розподіл</option>
                    <option value="1">👥 Пара #1</option>
                    <option value="2">👥 Пара #2</option>
                    <option value="3">👥 Пара #3</option>
                    <option value="4">👥 Пара #4</option>
                    <option value="5">👥 Пара #5</option>
                    <option value="6">👥 Пара #6</option>
                    <option value="swinger">🔄 Свінгер</option>
                </select>
                <button class="btn-primary" onclick="addPlayer()">+ Додати</button>
            </div>
        </div>

        <!-- VISUAL PAIRS BUILDER -->
        <div id="pairsContainer" class="pairs-grid"></div>

        <div class="controls-row">
            <button class="btn-secondary btn-sm" onclick="addDemoPlayers(6)">➕ 6 гравців (3 пари)</button>
            <button class="btn-secondary btn-sm" onclick="addDemoPlayers(7)">➕ 7 гравців (3 пари + 1)</button>
            <button class="btn-secondary btn-sm" onclick="addDemoPlayers(8)">➕ 8 гравців (4 пари)</button>
            <button class="btn-secondary btn-sm" onclick="addDemoPlayers(9)">➕ 9 гравців (4 пари + 1)</button>
            <button class="btn-secondary btn-sm" onclick="addDemoPlayers(10)">➕ 10 гравців (5 пар)</button>
            <button class="btn-secondary btn-sm" onclick="simulateMatches(10)">🎲 +10 матчів</button>
            <button class="btn-secondary btn-sm" onclick="exportData()">💾 Експорт</button>
            <button class="btn-secondary btn-sm" onclick="importData()">📥 Імпорт</button>
            <button class="btn-danger btn-sm" onclick="resetAll()">⚠️ Скинути все</button>
        </div>
    </section>

    <!-- TODAY STATS SUMMARY -->
    <section class="card">
        <h2>📊 Підсумок дня</h2>

        <div class="summary-grid">
            <div class="summary-card">
                <div id="todayMatches" class="summary-val">0</div>
                <div class="summary-lbl">Матчів</div>
            </div>

            <div class="summary-card">
                <div id="todayGames" class="summary-val">0</div>
                <div class="summary-lbl">Ігор гравців</div>
            </div>

            <div class="summary-card">
                <div id="todayWins" class="summary-val">0</div>
                <div class="summary-lbl">Перемог</div>
            </div>

            <div class="summary-card">
                <div id="todayPlayers" class="summary-val">0</div>
                <div class="summary-lbl">Активних</div>
            </div>
        </div>
    </section>

    <!-- DAILY RANKING -->
    <section class="card">
        <h2>🏆 Рейтинг за день</h2>
        <div id="dailyRanking"></div>
    </section>

    <!-- DUOS RANKING -->
    <section class="card">
        <h2>👥 Рейтинг дуетів (Пари)</h2>
        <div id="duoRanking"></div>
    </section>

    <!-- TOTAL RANKING -->
    <section class="card">
        <h2>🌎 Загальний рейтинг за весь час</h2>
        <div id="totalRanking"></div>
    </section>

    <!-- MATCH HISTORY -->
    <section class="card">
        <h2>📅 Історія матчів</h2>

        <div class="day-tabs">
            <button class="day-tab active" data-day="mon" onclick="setHistoryDay('mon')">Пн</button>
            <button class="day-tab" data-day="tue" onclick="setHistoryDay('tue')">Вт</button>
            <button class="day-tab" data-day="wed" onclick="setHistoryDay('wed')">Ср</button>
            <button class="day-tab" data-day="thu" onclick="setHistoryDay('thu')">Чт</button>
            <button class="day-tab" data-day="fri" onclick="setHistoryDay('fri')">Пт</button>
            <button class="day-tab" data-day="sat" onclick="setHistoryDay('sat')">Сб</button>
            <button class="day-tab" data-day="sun" onclick="setHistoryDay('sun')">Нд</button>
        </div>

        <div id="history"></div>
    </section>

</main>

<div id="toastContainer"></div>
<input type="file" id="importFileInput" style="display:none" accept=".json" onchange="handleFileImport(event)">

<script>
/* ============================================================
   DATA STATE
============================================================ */

const DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];

const DAY_NAMES = {
    mon: "Понеділок",
    tue: "Вівторок",
    wed: "Середа",
    thu: "Четвер",
    fri: "П'ятниця",
    sat: "Субота",
    sun: "Неділя"
};

const defaultState = {
    players: [],            // [ { name: "Боря", paused: false, pairId: 1 }, ... ]
    currentDay: "mon",
    days: {
        mon: [], tue: [], wed: [], thu: [], fri: [], sat: [], sun: []
    },
    rotation: {
        corePairs: [],          // [ ["Боря", "Даня"], ["Тьома", "Нацик"], ... ]
        pairQueue: [],          // [2, 3...] core pair indices waiting
        swinger: null,          // "Ромчик"
        swingerNextPairIdx: 0,  // Round-robin pair target for swinger
        tableA: null,           // { coreIdx: 0, currentPlayers: ["Боря", "Даня"], games: 0, withSwinger: false }
        tableB: null,           // { coreIdx: 1, currentPlayers: ["Тьома", "Нацик"], games: 0, withSwinger: false }
        isFirstMatch: true
    },
    undoStack: []
};

let state = loadState();
let historyDay = state.currentDay;

function loadState() {
    try {
        const raw = localStorage.getItem("pingPongState");
        if (!raw) return JSON.parse(JSON.stringify(defaultState));
        const parsed = JSON.parse(raw);

        let rawPlayers = Array.isArray(parsed.players) ? parsed.players : [];
        let players = rawPlayers.map((p, idx) => {
            if (typeof p === "string") return { name: p.trim(), paused: false, pairId: Math.floor(idx / 2) + 1 };
            if (p && typeof p === "object") {
                let pId = p.pairId !== undefined ? p.pairId : (p.customPair !== undefined ? p.customPair + 1 : Math.floor(idx / 2) + 1);
                return { name: (p.name || "").trim(), paused: !!p.paused, pairId: pId };
            }
            return { name: String(p || "").trim(), paused: false, pairId: 1 };
        }).filter(p => p.name !== "");

        const currentDay = (parsed.currentDay && DAYS.includes(parsed.currentDay)) ? parsed.currentDay : "mon";
        const days = parsed.days || defaultState.days;
        DAYS.forEach(d => { if (!Array.isArray(days[d])) days[d] = []; });

        return {
            players: players,
            currentDay: currentDay,
            days: days,
            rotation: parsed.rotation || defaultState.rotation,
            undoStack: Array.isArray(parsed.undoStack) ? parsed.undoStack : []
        };
    } catch (e) {
        console.error("Error loading state", e);
        return JSON.parse(JSON.stringify(defaultState));
    }
}

function save() {
    localStorage.setItem("pingPongState", JSON.stringify(state));
}

function showToast(message, type = "info") {
    const container = document.getElementById("toastContainer");
    const toast = document.createElement("div");
    toast.className = `toast ${type}`;
    
    let icon = "ℹ️";
    if (type === "success") icon = "✅";
    if (type === "error") icon = "⚠️";

    toast.innerHTML = `<span>${icon}</span><span>${escapeHtml(message)}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transition = "opacity 0.25s ease";
        setTimeout(() => toast.remove(), 250);
    }, 2400);
}

function getPlayerName(p) {
    if (typeof p === "string") return p;
    if (p && typeof p === "object") return p.name || "";
    return String(p || "");
}

function isPlayerPaused(p) {
    if (typeof p === "string") return false;
    if (p && typeof p === "object") return !!p.paused;
    return false;
}

function getActivePlayers() {
    return state.players
        .filter(p => !isPlayerPaused(p))
        .map(p => getPlayerName(p))
        .filter(n => n !== "");
}


/* ============================================================
   PERMANENT CORE PAIRS ROTATION WITH BALANCED TEMPORARY SWINGER
============================================================ */

function extractCorePairs() {
    const active = getActivePlayers();
    if (active.length < 4) return { corePairs: [], swinger: null };

    // Group active players by pairId
    const pairMap = {};
    const unassigned = [];
    let explicitSwinger = null;

    active.forEach(name => {
        const pObj = state.players.find(p => getPlayerName(p) === name);
        const pId = pObj ? pObj.pairId : "auto";
        if (pId === "swinger") {
            explicitSwinger = name;
        } else if (pId && pId !== "auto") {
            if (!pairMap[pId]) pairMap[pId] = [];
            pairMap[pId].push(name);
        } else {
            unassigned.push(name);
        }
    });

    const fullPairs = [];
    const partial = [];

    Object.keys(pairMap).sort((a, b) => parseInt(a, 10) - parseInt(b, 10)).forEach(k => {
        const list = pairMap[k];
        while (list.length >= 2) {
            fullPairs.push([list.shift(), list.shift()]);
        }
        if (list.length === 1) {
            partial.push(list.shift());
        }
    });

    const pool = [...partial, ...unassigned];
    while (pool.length >= 2) {
        fullPairs.push([pool.shift(), pool.shift()]);
    }

    let swinger = explicitSwinger;
    if (pool.length === 1) {
        if (!swinger) {
            swinger = pool.shift();
        } else {
            fullPairs.push([swinger, pool.shift()]);
            swinger = null;
        }
    }

    if (active.length % 2 === 0 && swinger) {
        const flat = [...fullPairs.flat(), swinger];
        fullPairs.length = 0;
        for (let i = 0; i < flat.length; i += 2) {
            fullPairs.push([flat[i], flat[i + 1]]);
        }
        swinger = null;
    } else if (active.length % 2 !== 0 && !swinger && fullPairs.length > 0) {
        const lastP = fullPairs.pop();
        fullPairs.push([lastP[0], null]);
        swinger = lastP[1];
        fullPairs.pop();
    }

    return { corePairs: fullPairs, swinger: swinger };
}

function rebuildRotation() {
    const { corePairs, swinger } = extractCorePairs();
    const active = getActivePlayers();

    if (active.length < 4 || corePairs.length < 2) {
        state.rotation = {
            corePairs: [],
            pairQueue: [],
            swinger: null,
            swingerNextPairIdx: 0,
            tableA: null,
            tableB: null,
            isFirstMatch: true
        };
        save();
        render();
        return;
    }

    const tableA = { coreIdx: 0, currentPlayers: [...corePairs[0]], games: 0, withSwinger: false };
    const tableB = { coreIdx: 1, currentPlayers: [...corePairs[1]], games: 0, withSwinger: false };

    const pairQueue = [];
    for (let i = 2; i < corePairs.length; i++) {
        pairQueue.push(i);
    }

    state.rotation = {
        corePairs: corePairs,
        pairQueue: pairQueue,
        swinger: swinger,
        swingerNextPairIdx: 0,
        tableA: tableA,
        tableB: tableB,
        isFirstMatch: true
    };

    save();
    render();
}

function updateBench() {
    const rot = state.rotation;
    if (!rot || !rot.tableA || !rot.tableB) {
        rebuildRotation();
        return;
    }

    const { corePairs, swinger } = extractCorePairs();
    const active = getActivePlayers();
    const tablePlayers = [...rot.tableA.currentPlayers, ...rot.tableB.currentPlayers];

    if (active.length < 4 || !tablePlayers.every(p => active.includes(p))) {
        rebuildRotation();
        return;
    }

    rot.corePairs = corePairs;
    rot.swinger = swinger;

    const currentTableIndices = [rot.tableA.coreIdx, rot.tableB.coreIdx];
    const available = [];
    for (let i = 0; i < corePairs.length; i++) {
        if (!currentTableIndices.includes(i)) {
            available.push(i);
        }
    }
    rot.pairQueue = available;
}

function ensureTableReady() {
    const active = getActivePlayers();
    if (active.length < 4) return;

    const rot = state.rotation;
    if (!rot || !rot.tableA || !rot.tableB || !rot.corePairs || !rot.corePairs.length) {
        rebuildRotation();
        return;
    }

    const currentTablePlayers = [...rot.tableA.currentPlayers, ...rot.tableB.currentPlayers];
    if (!currentTablePlayers.every(p => active.includes(p))) {
        rebuildRotation();
    }
}

function getNextIncomingTeam(leavingCoreIdx) {
    const stats = calculateStats(state.days[state.currentDay]);
    const rot = state.rotation;
    const corePairs = rot.corePairs || [];
    const swinger = rot.swinger;

    if (!Array.isArray(rot.pairQueue)) rot.pairQueue = [];

    // The leaving core pair index goes back to the queue
    if (typeof leavingCoreIdx === 'number' && !rot.pairQueue.includes(leavingCoreIdx)) {
        rot.pairQueue.push(leavingCoreIdx);
    }

    let nextCoreIdx = rot.pairQueue.shift();
    if (nextCoreIdx === undefined || !corePairs[nextCoreIdx]) {
        // Fallback to any index not on table
        const onTable = [rot.tableA ? rot.tableA.coreIdx : -1, rot.tableB ? rot.tableB.coreIdx : -1];
        for (let i = 0; i < corePairs.length; i++) {
            if (!onTable.includes(i)) {
                nextCoreIdx = i;
                break;
            }
        }
        if (nextCoreIdx === undefined) nextCoreIdx = 0;
    }

    const nextCore = corePairs[nextCoreIdx] || ["Гравець 1", "Гравець 2"];

    // Check if swinger should play with this incoming pair:
    let useSwinger = false;
    if (swinger) {
        const statsList = Object.values(stats);
        const avgGames = statsList.length ? statsList.reduce((s, x) => s + x.games, 0) / statsList.length : 0;
        const swingerGames = stats[swinger] ? stats[swinger].games : 0;
        
        if (nextCoreIdx === rot.swingerNextPairIdx && swingerGames <= avgGames + 0.5) {
            useSwinger = true;
            rot.swingerNextPairIdx = (rot.swingerNextPairIdx + 1) % corePairs.length;
        } else if (nextCoreIdx === rot.swingerNextPairIdx) {
            rot.swingerNextPairIdx = (rot.swingerNextPairIdx + 1) % corePairs.length;
        }
    }

    let incomingPlayers;
    if (useSwinger) {
        // Game 1: Swinger + Partner 0 (Partner 1 rests for 1 game)
        incomingPlayers = [swinger, nextCore[0]];
    } else {
        // Pure Core Pair
        incomingPlayers = [...nextCore];
    }

    return {
        coreIdx: nextCoreIdx,
        currentPlayers: incomingPlayers,
        games: 0,
        withSwinger: useSwinger
    };
}

function recordResult(winnerTeamCode) {
    ensureTableReady();
    const rot = state.rotation;
    if (!rot.tableA || !rot.tableB) return;

    // Snapshot for Undo
    const snapshot = JSON.stringify({
        rotation: JSON.parse(JSON.stringify(state.rotation)),
        matchDay: state.currentDay,
        matchesLength: state.days[state.currentDay].length
    });
    state.undoStack.push(snapshot);
    if (state.undoStack.length > 30) state.undoStack.shift();

    const matchRecord = {
        id: Date.now(),
        time: new Date().toLocaleTimeString("uk-UA", { hour: "2-digit", minute: "2-digit" }),
        teamA: [...rot.tableA.currentPlayers],
        teamB: [...rot.tableB.currentPlayers],
        winner: winnerTeamCode
    };
    state.days[state.currentDay].push(matchRecord);

    const winnerNames = winnerTeamCode === "A" ? rot.tableA.currentPlayers.join(" + ") : rot.tableB.currentPlayers.join(" + ");
    showToast(`🏆 ${winnerNames} перемогли!`, "success");

    if (rot.isFirstMatch) {
        rot.isFirstMatch = false;
        if (winnerTeamCode === "A") {
            rot.tableA.games = 1;
            const leavingIdx = rot.tableB.coreIdx;
            rot.tableB = getNextIncomingTeam(leavingIdx);
        } else {
            rot.tableB.games = 1;
            const leavingIdx = rot.tableA.coreIdx;
            rot.tableA = getNextIncomingTeam(leavingIdx);
        }
    } else {
        // Correct staggered rotation: check which table is finishing Game 2 (games >= 1)
        if (rot.tableA.games >= 1) {
            // Table A finished 2 games -> LEAVES!
            // Table B stays for Game 2 (games becomes 1)!
            rot.tableB.games = 1;
            if (rot.tableB.withSwinger && rot.swinger) {
                const core = rot.corePairs[rot.tableB.coreIdx];
                if (core && core.length === 2) {
                    rot.tableB.currentPlayers = [rot.swinger, core[1]];
                }
            }
            const leavingIdx = rot.tableA.coreIdx;
            rot.tableA = getNextIncomingTeam(leavingIdx);
        } else {
            // Table B finished 2 games -> LEAVES!
            // Table A stays for Game 2 (games becomes 1)!
            rot.tableA.games = 1;
            if (rot.tableA.withSwinger && rot.swinger) {
                const core = rot.corePairs[rot.tableA.coreIdx];
                if (core && core.length === 2) {
                    rot.tableA.currentPlayers = [rot.swinger, core[1]];
                }
            }
            const leavingIdx = rot.tableB.coreIdx;
            rot.tableB = getNextIncomingTeam(leavingIdx);
        }
    }

    save();
    render();
}

function undoLastMatch() {
    if (!state.undoStack.length) return;
    const snapshot = JSON.parse(state.undoStack.pop());

    if (state.days[snapshot.matchDay]) {
        state.days[snapshot.matchDay].length = snapshot.matchesLength;
    }

    state.rotation = snapshot.rotation;
    save();
    render();
    showToast("↩️ Результат скасовано", "info");
}

function deleteMatch(day, matchIndex) {
    state.days[day].splice(matchIndex, 1);
    save();
    render();
    showToast("Матч видалено", "info");
}

function simulateMatches(count) {
    for (let i = 0; i < count; i++) {
        const winner = Math.random() > 0.5 ? "A" : "B";
        recordResult(winner);
    }
}


/* ============================================================
   PLAYERS & CUSTOM PAIRS BUILDER
============================================================ */

function addPlayer() {
    const input = document.getElementById("playerInput");
    const select = document.getElementById("pairSelectDropdown");
    const name = input.value.trim();
    if (!name) return;

    const exists = state.players.some(p => getPlayerName(p).toLowerCase() === name.toLowerCase());
    if (exists) {
        showToast("Гравець з таким ім'ям вже є", "error");
        return;
    }

    let targetPair = select.value;
    let finalPairId = 1;

    if (targetPair === "swinger") {
        finalPairId = "swinger";
    } else if (targetPair === "auto") {
        const pairCounts = {};
        state.players.forEach(p => {
            if (p.pairId !== "swinger") {
                pairCounts[p.pairId] = (pairCounts[p.pairId] || 0) + 1;
            }
        });

        let foundPair = null;
        for (let i = 1; i <= 20; i++) {
            if (!pairCounts[i] || pairCounts[i] < 2) {
                foundPair = i;
                break;
            }
        }
        finalPairId = foundPair || 1;
    } else {
        finalPairId = parseInt(targetPair, 10);
    }

    state.players.push({ name: name, paused: false, pairId: finalPairId });
    input.value = "";

    rebuildRotation();
    save();
    render();
    showToast(`Гравця ${name} додано до ${finalPairId === 'swinger' ? 'Свінгера' : 'Пари #' + finalPairId}!`, "success");
}

function setPlayerPair(name, newPairId) {
    const p = state.players.find(x => getPlayerName(x) === name);
    if (p) {
        p.pairId = newPairId === "swinger" ? "swinger" : parseInt(newPairId, 10);
        rebuildRotation();
        save();
        render();
        showToast(`${name} переміщено до ${newPairId === 'swinger' ? 'Свінгера' : 'Пари #' + newPairId}`, "info");
    }
}

function autoBalancePairs() {
    state.players.forEach((p, idx) => {
        p.pairId = Math.floor(idx / 2) + 1;
    });

    if (state.players.length % 2 !== 0) {
        state.players[state.players.length - 1].pairId = "swinger";
    }

    rebuildRotation();
    save();
    render();
    showToast("Пари авто-розподілено!", "success");
}

function renamePlayer(oldName) {
    const newName = prompt(`Нове ім'я для ${oldName}:`, oldName);
    if (!newName || !newName.trim() || newName.trim() === oldName) return;

    const cleanName = newName.trim();
    if (state.players.some(p => getPlayerName(p).toLowerCase() === cleanName.toLowerCase())) {
        showToast("Гравець з таким ім'ям вже є", "error");
        return;
    }

    state.players.forEach(p => {
        if (getPlayerName(p) === oldName) p.name = cleanName;
    });

    const rot = state.rotation;
    if (rot) {
        if (rot.swinger === oldName) rot.swinger = cleanName;
        if (rot.tableA) rot.tableA.currentPlayers = rot.tableA.currentPlayers.map(p => p === oldName ? cleanName : p);
        if (rot.tableB) rot.tableB.currentPlayers = rot.tableB.currentPlayers.map(p => p === oldName ? cleanName : p);
        if (Array.isArray(rot.corePairs)) {
            rot.corePairs = rot.corePairs.map(pair => pair.map(p => p === oldName ? cleanName : p));
        }
    }

    DAYS.forEach(day => {
        (state.days[day] || []).forEach(m => {
            m.teamA = m.teamA.map(p => p === oldName ? cleanName : p);
            m.teamB = m.teamB.map(p => p === oldName ? cleanName : p);
        });
    });

    save();
    render();
    showToast(`Ім'я оновлено`, "success");
}

function togglePlayerPause(name) {
    const idx = state.players.findIndex(x => getPlayerName(x) === name);
    if (idx !== -1) {
        const current = state.players[idx];
        const isPaused = isPlayerPaused(current);
        state.players[idx] = { ...current, paused: !isPaused };
        updateBench();
        save();
        render();
        showToast(`${name} ${!isPaused ? 'на паузі ⏸️' : 'в грі 🟢'}`, "info");
    }
}

function removePlayer(name) {
    if (!confirm(`Видалити гравця ${name}?`)) return;
    state.players = state.players.filter(p => getPlayerName(p) !== name);
    updateBench();
    save();
    render();
    showToast(`${name} видалено`, "info");
}

function addDemoPlayers(count = 7) {
    const allDemo = ["Боря", "Даня", "Тьома", "Нацик", "Андрій", "Яніс", "Льоха", "Макуха", "Ромчик", "Вова"];
    const toAdd = allDemo.slice(0, count);

    state.players = toAdd.map((name, idx) => {
        const pairId = (count % 2 !== 0 && idx === count - 1) ? "swinger" : Math.floor(idx / 2) + 1;
        return { name: name, paused: false, pairId: pairId };
    });

    rebuildRotation();
    save();
    render();
    showToast(`Завантажено ${count} гравців!`, "success");
}


/* ============================================================
   STATS & RANKINGS
============================================================ */

function calculateStats(matches) {
    const stats = {};
    state.players.forEach(p => {
        const name = getPlayerName(p);
        if (name) stats[name] = { games: 0, wins: 0, losses: 0, points: 0, streak: 0 };
    });

    if (!matches) return stats;

    matches.forEach(m => {
        m.teamA.forEach(name => {
            if (!stats[name]) stats[name] = { games: 0, wins: 0, losses: 0, points: 0, streak: 0 };
            stats[name].games++;
            if (m.winner === "A") {
                stats[name].wins++;
                stats[name].points += 3;
                stats[name].streak = stats[name].streak > 0 ? stats[name].streak + 1 : 1;
            } else {
                stats[name].losses++;
                stats[name].streak = stats[name].streak < 0 ? stats[name].streak - 1 : -1;
            }
        });

        m.teamB.forEach(name => {
            if (!stats[name]) stats[name] = { games: 0, wins: 0, losses: 0, points: 0, streak: 0 };
            stats[name].games++;
            if (m.winner === "B") {
                stats[name].wins++;
                stats[name].points += 3;
                stats[name].streak = stats[name].streak > 0 ? stats[name].streak + 1 : 1;
            } else {
                stats[name].losses++;
                stats[name].streak = stats[name].streak < 0 ? stats[name].streak - 1 : -1;
            }
        });
    });

    return stats;
}

function calculateDuoStats(matches) {
    const duos = {};
    if (!matches) return [];

    matches.forEach(m => {
        [
            { team: m.teamA, win: m.winner === "A" },
            { team: m.teamB, win: m.winner === "B" }
        ].forEach(t => {
            if (t.team && t.team.length === 2) {
                const pairKey = [...t.team].sort().join(" + ");
                if (!duos[pairKey]) duos[pairKey] = { games: 0, wins: 0, losses: 0 };
                duos[pairKey].games++;
                if (t.win) duos[pairKey].wins++;
                else duos[pairKey].losses++;
            }
        });
    });

    return Object.entries(duos)
        .map(([duo, s]) => ({
            duo,
            games: s.games,
            wins: s.wins,
            losses: s.losses,
            winRate: Math.round((s.wins / s.games) * 100)
        }))
        .sort((a, b) => (b.wins - a.wins) || (b.winRate - a.winRate) || (b.games - a.games));
}


/* ============================================================
   RENDERING
============================================================ */

function renderPairsBuilder() {
    const container = document.getElementById("pairsContainer");
    const countEl = document.getElementById("playerCount");
    countEl.textContent = state.players.length;

    if (!state.players.length) {
        container.innerHTML = `<div class="empty-state">Поки немає жодного гравця. Введіть ім'я вгорі і натисніть «+ Додати».</div>`;
        return;
    }

    const groups = {};
    state.players.forEach(p => {
        const pId = p.pairId !== undefined ? p.pairId : 1;
        if (!groups[pId]) groups[pId] = [];
        groups[pId].push(p);
    });

    const pairKeys = Object.keys(groups).filter(k => k !== "swinger").sort((a, b) => parseInt(a, 10) - parseInt(b, 10));

    let html = "";

    pairKeys.forEach(k => {
        const list = groups[k] || [];
        html += `
            <div class="pair-card">
                <div class="pair-card-header">
                    <span class="pair-card-title">👥 Пара #${k}</span>
                    <span class="badge">${list.length}/2 гравці</span>
                </div>
                <div class="pair-players-row">
                    ${list.map(p => renderPlayerItem(p)).join("")}
                    ${list.length < 2 ? `<div class="player-row-item empty-slot">➕ Очікує напарника...</div>` : ''}
                </div>
            </div>
        `;
    });

    if (groups["swinger"] && groups["swinger"].length > 0) {
        html += `
            <div class="pair-card swinger-card">
                <div class="pair-card-header">
                    <span class="pair-card-title" style="color:#e879f9">🔄 Свінгер (підміна)</span>
                    <span class="badge badge-swinger">${groups["swinger"].length} гравець</span>
                </div>
                <div class="pair-players-row">
                    ${groups["swinger"].map(p => renderPlayerItem(p)).join("")}
                </div>
            </div>
        `;
    }

    container.innerHTML = html;
}

function renderPlayerItem(p) {
    const name = getPlayerName(p);
    const paused = isPlayerPaused(p);
    const currentPairId = p.pairId !== undefined ? String(p.pairId) : "1";

    return `
        <div class="player-row-item ${paused ? 'paused' : ''}">
            <span>${paused ? '⏸️' : '🟢'} <strong>${escapeHtml(name)}</strong></span>
            <div class="player-actions-mini">
                <select class="pair-select-mini" onchange="setPlayerPair('${escapeJs(name)}', this.value)" title="Змінити пару">
                    <option value="1" ${currentPairId === "1" ? "selected" : ""}>Пара 1</option>
                    <option value="2" ${currentPairId === "2" ? "selected" : ""}>Пара 2</option>
                    <option value="3" ${currentPairId === "3" ? "selected" : ""}>Пара 3</option>
                    <option value="4" ${currentPairId === "4" ? "selected" : ""}>Пара 4</option>
                    <option value="5" ${currentPairId === "5" ? "selected" : ""}>Пара 5</option>
                    <option value="6" ${currentPairId === "6" ? "selected" : ""}>Пара 6</option>
                    <option value="swinger" ${currentPairId === "swinger" ? "selected" : ""}>Свінгер</option>
                </select>
                <button type="button" class="mini-btn" onclick="renamePlayer('${escapeJs(name)}')" title="Перейменувати">✏️</button>
                <button type="button" class="mini-btn" onclick="togglePlayerPause('${escapeJs(name)}')" title="Пауза">${paused ? '▶️' : '⏸️'}</button>
                <button type="button" class="mini-btn remove" onclick="removePlayer('${escapeJs(name)}')" title="Видалити">×</button>
            </div>
        </div>
    `;
}

function renderMatch() {
    const container = document.getElementById("matchContent");
    const undoContainer = document.getElementById("matchHeaderRight");
    const active = getActivePlayers();

    if (state.undoStack.length > 0) {
        undoContainer.innerHTML = `
            <button class="btn-undo" onclick="undoLastMatch()">
                ↩️ Скасувати
            </button>
        `;
    } else {
        undoContainer.innerHTML = "";
    }

    if (active.length < 4) {
        container.innerHTML = `
            <div class="empty-state">
                Для гри потрібно мінімум <strong>4 активні гравці</strong> (зараз: ${active.length}).<br>
                Додайте ще ${4 - active.length} гравців, щоб розпочати турнір.
            </div>
        `;
        return;
    }

    ensureTableReady();

    const rot = state.rotation;
    const teamA = rot.tableA;
    const teamB = rot.tableB;

    if (!teamA || !teamB) {
        container.innerHTML = `<div class="empty-state">Формування столу...</div>`;
        return;
    }

    const gameA = teamA.games + 1;
    const gameB = teamB.games + 1;
    const matchCount = state.days[state.currentDay].length + 1;

    let hintText = "";
    if (rot.isFirstMatch) {
        hintText = "⚡ <strong>Перший матч</strong>: переможець залишається на 2-гу гру, програвший виходить у чергу.";
    } else {
        const leaving = teamA.games >= 1 ? teamA.currentPlayers.join(" + ") : teamB.currentPlayers.join(" + ");
        const staying = teamA.games >= 1 ? teamB.currentPlayers.join(" + ") : teamA.currentPlayers.join(" + ");
        hintText = `🔄 Після матчу <strong>${escapeHtml(leaving)}</strong> виходять, а <strong>${escapeHtml(staying)}</strong> грають 2-гу гру.`;
    }

    container.innerHTML = `
        <div class="match-header-info">
            <span class="match-tag">Матч #${matchCount}</span>
            <span class="badge">${active.length} активних гравців</span>
        </div>

        <div class="teams-grid">
            <div class="team-box team-a ${gameA === 2 ? 'final-game' : ''}">
                <div class="team-title">Команда A ${teamA.withSwinger ? '⚡ (зі Свінгером)' : ''}</div>
                <div class="team-names">${teamA.currentPlayers.map(escapeHtml).join(" + ")}</div>
                <div class="game-pill ${gameA === 1 ? 'game-1' : 'game-2'}">
                    ${gameA === 1 ? '🟢 Гра 1 з 2' : '🟡 Фінал (2 з 2)'}
                </div>
            </div>

            <div class="vs-divider">VS</div>

            <div class="team-box team-b ${gameB === 2 ? 'final-game' : ''}">
                <div class="team-title">Команда B ${teamB.withSwinger ? '⚡ (зі Свінгером)' : ''}</div>
                <div class="team-names">${teamB.currentPlayers.map(escapeHtml).join(" + ")}</div>
                <div class="game-pill ${gameB === 1 ? 'game-1' : 'game-2'}">
                    ${gameB === 1 ? '🟢 Гра 1 з 2' : '🟡 Фінал (2 з 2)'}
                </div>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn-win-a" onclick="recordResult('A')">
                🏆 ${teamA.currentPlayers.map(escapeHtml).join(" + ")}
            </button>
            <button class="btn-win-b" onclick="recordResult('B')">
                🏆 ${teamB.currentPlayers.map(escapeHtml).join(" + ")}
            </button>
        </div>

        <div class="rotation-status-banner">
            <div>${hintText}</div>
        </div>
    `;
}

function renderQueue() {
    const queueList = document.getElementById("queueList");
    const swingerList = document.getElementById("swingerList");
    const queueCount = document.getElementById("queueCount");
    const swingerBadge = document.getElementById("swingerStatusBadge");

    const rot = state.rotation;
    const pairQueue = rot.pairQueue || [];
    const corePairs = rot.corePairs || [];
    const swinger = rot.swinger;

    queueCount.textContent = pairQueue.length;

    if (!pairQueue.length) {
        queueList.innerHTML = `<div class="empty-state" style="padding:6px">Всі пари на столі</div>`;
    } else {
        queueList.innerHTML = pairQueue.map((pairIdx, idx) => {
            const pairPlayers = corePairs[pairIdx] || [];
            return `
                <div class="queue-item">
                    <span>#${idx + 1} · Пара #${pairIdx + 1} (${pairPlayers.map(escapeHtml).join(" + ")})</span>
                    <span class="badge">Готуються</span>
                </div>
            `;
        }).join("");
    }

    if (!swinger) {
        swingerBadge.textContent = "Немає (парна к-сть)";
        swingerList.innerHTML = `<div class="empty-state" style="padding:6px">Немає (парна кількість гравців)</div>`;
    } else {
        swingerBadge.textContent = "1 гравець";
        swingerList.innerHTML = `
            <div class="queue-item">
                <span>🔄 <strong>${escapeHtml(swinger)}</strong></span>
                <span class="swinger-badge">Зайде на чергу</span>
            </div>
        `;
    }
}

function renderSummary() {
    const matches = state.days[state.currentDay];
    const stats = calculateStats(matches);

    const totalGames = Object.values(stats).reduce((sum, s) => sum + s.games, 0);
    const totalWins = Object.values(stats).reduce((sum, s) => sum + s.wins, 0);
    const activePlayers = Object.values(stats).filter(s => s.games > 0).length;

    document.getElementById("todayMatches").textContent = matches ? matches.length : 0;
    document.getElementById("todayGames").textContent = totalGames;
    document.getElementById("todayWins").textContent = totalWins;
    document.getElementById("todayPlayers").textContent = activePlayers;
}

function renderRanking() {
    const matches = state.days[state.currentDay];
    const stats = calculateStats(matches);

    const rows = Object.entries(stats).sort((a, b) => {
        return (b[1].points - a[1].points) || (b[1].wins - a[1].wins) || (b[1].games - a[1].games);
    });

    document.getElementById("dailyRanking").innerHTML = makeRankingTable(rows);

    const allMatches = DAYS.flatMap(day => state.days[day] || []);
    const totalStats = calculateStats(allMatches);
    const totalRows = Object.entries(totalStats).sort((a, b) => {
        return (b[1].points - a[1].points) || (b[1].wins - a[1].wins) || (b[1].games - a[1].games);
    });

    document.getElementById("totalRanking").innerHTML = makeRankingTable(totalRows);

    const duoStats = calculateDuoStats(allMatches);
    renderDuoTable(duoStats);
}

function makeRankingTable(rows) {
    if (!rows.length || rows.every(r => r[1].games === 0)) {
        return `<div class="empty-state">Поки немає зіграних матчів.</div>`;
    }

    return `
        <div class="table-responsive">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Гравець</th>
                        <th>Ігор</th>
                        <th>W</th>
                        <th>L</th>
                        <th>Win%</th>
                        <th>Серія</th>
                        <th>Очки</th>
                    </tr>
                </thead>
                <tbody>
                    ${rows.map(([name, s], index) => {
                        const winRate = s.games ? Math.round((s.wins / s.games) * 100) : 0;
                        const rankClass = index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : '';
                        
                        let streakHtml = `<span style="color:var(--text-muted)">—</span>`;
                        if (s.streak > 0) {
                            streakHtml = `<span class="streak-badge streak-w">🔥 ${s.streak}W</span>`;
                        } else if (s.streak < 0) {
                            streakHtml = `<span class="streak-badge streak-l">❄️ ${Math.abs(s.streak)}L</span>`;
                        }

                        return `
                            <tr>
                                <td class="rank-cell ${rankClass}">#${index + 1}</td>
                                <td><strong>${escapeHtml(name)}</strong></td>
                                <td>${s.games}</td>
                                <td style="color:var(--green);font-weight:700">${s.wins}</td>
                                <td style="color:var(--red);font-weight:700">${s.losses}</td>
                                <td><strong>${winRate}%</strong></td>
                                <td>${streakHtml}</td>
                                <td><strong style="color:#60a5fa">${s.points}</strong></td>
                            </tr>
                        `;
                    }).join("")}
                </tbody>
            </table>
        </div>
    `;
}

function renderDuoTable(duos) {
    const container = document.getElementById("duoRanking");
    if (!duos.length) {
        container.innerHTML = `<div class="empty-state">Немає даних про дуети.</div>`;
        return;
    }

    container.innerHTML = `
        <div class="table-responsive">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Дует</th>
                        <th>Ігор</th>
                        <th>W</th>
                        <th>L</th>
                        <th>Win%</th>
                    </tr>
                </thead>
                <tbody>
                    ${duos.map((d, index) => `
                        <tr>
                            <td class="rank-cell">#${index + 1}</td>
                            <td><strong>${escapeHtml(d.duo)}</strong></td>
                            <td>${d.games}</td>
                            <td style="color:var(--green);font-weight:700">${d.wins}</td>
                            <td style="color:var(--red);font-weight:700">${d.losses}</td>
                            <td><strong>${d.winRate}%</strong></td>
                        </tr>
                    `).join("")}
                </tbody>
            </table>
        </div>
    `;
}

function renderHistory() {
    const matches = state.days[historyDay] || [];
    const container = document.getElementById("history");

    if (!matches.length) {
        container.innerHTML = `<div class="empty-state">У ${DAY_NAMES[historyDay].toLowerCase()} матчів ще немає.</div>`;
        return;
    }

    container.innerHTML = [...matches].reverse().map((match, reverseIndex) => {
        const matchIndex = matches.length - 1 - reverseIndex;
        const number = matches.length - reverseIndex;
        const isWinA = match.winner === "A";

        return `
            <div class="history-item">
                <div class="history-main">
                    <span class="history-num">#${number}</span>
                    <span class="${isWinA ? 'history-winner' : 'history-loser'}">
                        ${isWinA ? '🏆 ' : ''}${match.teamA.map(escapeHtml).join(" + ")}
                    </span>
                    <span style="color:var(--text-muted);font-size:11px">vs</span>
                    <span class="${!isWinA ? 'history-winner' : 'history-loser'}">
                        ${!isWinA ? '🏆 ' : ''}${match.teamB.map(escapeHtml).join(" + ")}
                    </span>
                </div>
                <div class="history-meta">
                    <span>${match.time}</span>
                    <button class="btn-delete-match" onclick="deleteMatch('${historyDay}', ${matchIndex})" title="Видалити">
                        🗑️
                    </button>
                </div>
            </div>
        `;
    }).join("");
}

function changeDay() {
    state.currentDay = document.getElementById("daySelect").value;
    historyDay = state.currentDay;
    rebuildRotation();
    save();
    render();
}

function setHistoryDay(day) {
    historyDay = day;
    document.querySelectorAll(".day-tab").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.day === day);
    });
    renderHistory();
}

function escapeHtml(value) {
    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

function escapeJs(value) {
    return String(value)
        .replaceAll("\\", "\\\\")
        .replaceAll("'", "\\'");
}

function exportData() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
    const dlAnchor = document.createElement('a');
    dlAnchor.setAttribute("href", dataStr);
    dlAnchor.setAttribute("download", `ping_pong_backup_${new Date().toISOString().slice(0,10)}.json`);
    dlAnchor.click();
    showToast("💾 Дані експортовано!", "success");
}

function importData() {
    document.getElementById("importFileInput").click();
}

function handleFileImport(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(evt) {
        try {
            const imported = JSON.parse(evt.target.result);
            if (imported.players && imported.days) {
                state = imported;
                save();
                render();
                showToast("Дані імпортовано!", "success");
            } else {
                showToast("Невірний формат JSON", "error");
            }
        } catch (err) {
            showToast("Помилка читання JSON", "error");
        }
    };
    reader.readAsText(file);
}

function resetAll() {
    if (!confirm("⚠️ ВИ ВПЕВНЕНІ? Всі результати будуть видалені!")) return;
    localStorage.removeItem("pingPongState");
    state = JSON.parse(JSON.stringify(defaultState));
    render();
    showToast("Всі дані очищено", "info");
}


/* ============================================================
   MAIN RENDER
============================================================ */

function render() {
    document.getElementById("daySelect").value = state.currentDay;
    renderPairsBuilder();
    renderMatch();
    renderQueue();
    renderSummary();
    renderRanking();
    renderHistory();
}

render();

</script>
</body>
</html>
